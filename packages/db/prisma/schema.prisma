generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  name             String?
  email            String?          @unique
  image            String?
  emailVerified    DateTime?

  role             UserRole         @default(EMPLOYEE)

  accounts         Account[]
  activities       Activity[]
  desktopDevices   DesktopDevice[]
  desktopAuthCodes DesktopAuthCode[]
  privacySettings  PrivacySettings?
  projects         Project[]
  sessions         Session[]
  timesheets       Timesheet[]
  activityEvents   ActivityEvent[]
  screenshots      Screenshot[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id               String           @id @default(uuid())
  name             String
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  userId           String
  activities       Activity[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  timesheetEntries TimesheetEntry[]

  @@index([userId])
}

model Activity {
  id             String                  @id @default(uuid())
  application    String
  windowTitle    String?
  startedAt      DateTime
  endedAt        DateTime
  duration       Int
  userId         String
  projectId      String?
  project        Project?                @relation(fields: [projectId], references: [id])
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classification ActivityClassification?

  @@index([userId])
  @@index([projectId])
  @@index([startedAt])
}

model ActivityEvent {
  id        String            @id @default(uuid())
  userId    String
  deviceId  String?
  type      ActivityEventType
  timestamp DateTime          @default(now())

  mouseDistance Int?
  mouseClicks   Int?
  keyPresses    Int?

  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model ActivityClassification {
  id         String           @id @default(uuid())
  category   ActivityCategory
  confidence Float
  reason     String?
  createdAt  DateTime         @default(now())
  activityId String           @unique
  activity   Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Screenshot {
  id          String   @id @default(uuid())
  userId      String
  deviceId    String?
  storageKey  String
  application String?
  website     String?
  capturedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([capturedAt])
}

model Timesheet {
  id        String           @id @default(uuid())
  date      DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   TimesheetEntry[]

  @@unique([userId, date])
  @@index([userId, date])
}

model TimesheetEntry {
  id          String           @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  description String
  category    ActivityCategory
  confidence  Float?
  approved    Boolean          @default(false)
  timesheetId String
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  timesheet   Timesheet        @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId])
  @@index([projectId])
}

model PrivacySettings {
  id                       String   @id @default(uuid())
  trackingEnabled          Boolean  @default(true)
  retentionDays            Int      @default(30)
  inactivityTimeoutMinutes Int      @default(30)
  screenshotIntervalMinutes Int @default(5)
  updatedAt                DateTime @updatedAt
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DesktopDevice {
  id         String    @id @default(uuid())
  name       String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DesktopAuthCode {
  id         String   @id @default(uuid())
  codeHash   String   @unique
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  EMPLOYEE
  HR
}

enum ActivityCategory {
  DESIGN
  RESEARCH
  COMMUNICATION
  DOCUMENTATION
  DEVELOPMENT
  OTHER
}

enum ActivityEventType {
  MOUSE
  KEYBOARD
  ACTIVE_WINDOW
}
