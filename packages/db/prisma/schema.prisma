generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActivityCategory {
  DESIGN
  RESEARCH
  COMMUNICATION
  DOCUMENTATION
  DEVELOPMENT
  OTHER
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  projects        Project[]
  activities      Activity[]
  timesheets      Timesheet[]
  privacySettings PrivacySettings?

  desktopDevices DesktopDevice[]
}

model Account {
  id                String @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activities       Activity[]
  timesheetEntries TimesheetEntry[]

  @@index([userId])
}

model Activity {
  id          String   @id @default(uuid())
  application String
  windowTitle String?
  startedAt   DateTime
  endedAt     DateTime
  duration    Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  classification ActivityClassification?

  @@index([userId])
  @@index([projectId])
  @@index([startedAt])
}

model ActivityClassification {
  id         String           @id @default(uuid())
  category   ActivityCategory
  confidence Float
  reason     String?
  createdAt  DateTime         @default(now())

  activityId String   @unique
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Timesheet {
  id        String   @id @default(uuid())
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries TimesheetEntry[]

  @@index([userId, date])
}

model TimesheetEntry {
  id          String           @id @default(uuid())
  startTime   DateTime
  endTime     DateTime
  description String
  category    ActivityCategory
  confidence  Float?
  approved    Boolean          @default(false)

  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([timesheetId])
  @@index([projectId])
}

model PrivacySettings {
  id              String   @id @default(uuid())
  trackingEnabled Boolean  @default(false)
  retentionDays   Int      @default(30)
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DesktopDevice {
  id         String    @id @default(uuid())
  name       String?
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
