<Window x:Class="FocusTrace.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusTrace"
        Width="360"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            Text="FocusTrace"
            FontSize="28"
            FontWeight="Bold"
            Foreground="#111827"
            HorizontalAlignment="Center"/>

        <!-- Tracking status -->
        <StackPanel
            Grid.Row="1"
            Margin="0,25,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal">

            <Ellipse
                x:Name="StatusIndicator"
                Width="12"
                Height="12"
                Margin="0,0,8,0"
                Fill="#9CA3AF"/>

            <TextBlock
                x:Name="TrackingStatusText"
                Text="Tracking DISABLED"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="#374151"/>
        </StackPanel>

        <!-- Connect button -->
        <Button
            x:Name="ConnectButton"
            Grid.Row="2"
            Width="180"
            Height="48"
            Margin="0,30,0,20"
            HorizontalAlignment="Center"
            Content="CONNECT"
            FontSize="16"
            FontWeight="SemiBold"
            Click="ConnectButton_Click"/>

        <!-- Connection text -->
        <TextBlock
            x:Name="ConnectionStatusText"
            Grid.Row="3"
            Text="Not connected"
            FontSize="13"
            Foreground="#6B7280"
            HorizontalAlignment="Center"
            TextAlignment="Center"/>

    </Grid>

</Window>